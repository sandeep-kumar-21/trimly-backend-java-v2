# ==========================================
# Trimly Java Backend (.gitignore)
# ==========================================

# Compiled Java class files
*.class

# Log files and directories
*.log
logs/

# Package Files (JAR / WAR / EAR)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven build artifacts
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Keep Maven Wrapper properties and execution scripts
!.mvn/wrapper/maven-wrapper.properties
!mvnw
!mvnw.cmd

# Eclipse / Spring Tool Suite (STS)
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Visual Studio Code
.vscode/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
[Dd]esktop.ini

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env

# JVM crash logs and diagnostics
hs_err_pid*
replay_pid*

# JaCoCo Code Coverage
.jacoco/
jacoco.exec

# Temporary scratch and temp directories
scratch/
tmp/
temp/
